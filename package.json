{
  "name": "doomscroll-blocker",
  "version": "1.0.7",
  "description": "A chrome extension to block doom scrolling and help you touch grass!",
  "private": true,
  "scripts": {
    "watch": "node scripts/build.mjs --watch",
    "build": "pnpm typecheck && node scripts/build.mjs && pnpm dist",
    "dist": "rm -rf dist && mkdir -p dist && cd build/ && bestzip ../dist/build.zip *",
    "test": "node --test scripts/constants.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown \"{public,scripts,src}/**/*.{html,css,js,mjs,ts,json}\""
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "bestzip": "^2.2.1",
    "esbuild": "^0.28.1",
    "prettier": "^2.7.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "^3.1.5",
      "minimatch@5": "^5.1.9",
      "brace-expansion@1": "^1.1.15",
      "brace-expansion@2": "^2.0.3"
    }
  }
}